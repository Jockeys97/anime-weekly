{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "Dockerfile" },
  "deploy": {
    "numReplicas": 1,
    "cronSchedule": "0 6 * * *",
    "startCommand": "node scripts/cron.mjs",
    "healthcheckPath": null,
    "restartPolicyType": "NEVER"
  }
}
