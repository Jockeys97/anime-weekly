# Supply either TMDB credential. The Bearer token takes precedence.
TMDB_API_KEY=
TMDB_READ_TOKEN=
# Optional; without it IMDb ratings and vote counts display n/a.
OMDB_API_KEY=
# Required to authorize the daily cron; use a long random value.
CRON_SECRET=
# Optional DeepL API Free key (ends in :fx); server-only, never NEXT_PUBLIC_.
# Without this key, missing source translations keep the labelled English text.
DEEPL_AUTH_KEY=
